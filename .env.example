# ==============================
# DATABASE
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fitnessgen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/fitnessgen_db

# ==============================
# LLM PROVIDER
# ==============================
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# ==============================
# GROQ API
# ==============================
GROQ_API_KEY=change-me

# ==============================
# MCP SERVER
# ==============================
MCP_TRANSPORT=stdio

# ==============================
# API CONFIG
# ==============================
API_ENV=development
API_PORT=8000
LOG_LEVEL=INFO

# ==============================
# CORS
# ==============================
ALLOWED_ORIGINS=*
